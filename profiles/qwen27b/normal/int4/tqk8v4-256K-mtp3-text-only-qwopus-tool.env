# Derived profile for Qwopus3.6-27B-Coder-GPTQ-Pro with tool calling
#
# Source: profiles/qwen27b/fast/int4/tqk8v4-256K-mtp3-text-only.env
# (Switched from normal to fast profile for FULL_AND_PIECEWISE cudagraph)
# Differences from source:
#   - SERVED_NAME: qwopus27b-coder-gptq-pro
#   - Added ENABLE_AUTO_TOOL_CHOICE=1, TOOL_CALL_PARSER=qwen3_coder
#   - Added REASONING_PARSER=qwen3, DEFAULT_CHAT_TEMPLATE_KWARGS

SERVED_NAME=qwopus27b-coder-gptq-pro
COMPATIBLE_MODES=fast
MODEL_FAMILY=qwen
PROFILE_GROUP=qwen36-27b-int4
MODEL_VARIANT=int4
KV_CACHE_DTYPE=turboquant_k8v4
MAX_MODEL_LEN=262144
GPU_UTIL=0.94
MAX_BATCHED_TOKENS=2048
MAX_NUM_SEQS=1
MTP_K=3
LANGUAGE_MODEL_ONLY=1
SKIP_MM_PROFILING=1
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
